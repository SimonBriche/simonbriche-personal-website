# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{js}]
charset = utf-8

[*.mk]
indent_style = tab
max_line_length = unset

# Handled by prettier
[src/**/*.js]
max_line_length = unset

[*.pug]
max_line_length = unset

[*.{yml,yaml}]
indent_size = 2
indent_style = space
max_line_length = unset

# Fix for json files
[*.json]
max_line_length = unset
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = unset
indent_size = unset

[*.{sh,bash}]
max_line_length = unset

[LICENSE]
max_line_length = unset
indent_style = unset
indent_size = unset

[Dockerfile]
max_line_length = unset

# local keys
[keys/**/*.*]
max_line_length = unset
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# assets for dev files
[dev/**/*.*]
max_line_length = unset
indent_style = unset
charset = unset

# public files (generated)
[public/tarteaucitron/**/*.*]
max_line_length = unset
indent_size = unset
indent_style = unset

[public/react-cmp/**/*.*]
max_line_length = unset

[public/assets/css/*.css]
max_line_length = unset
